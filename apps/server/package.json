{
  "name": "@robot-puzzle/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787 --inspector-port 9230 --persist-to .wrangler/state",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "pnpm types && tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run && vitest run --config vitest.persistence.config.ts",
    "test:watch": "vitest",
    "benchmark:round-setup": "vitest run --config vitest.benchmark.config.ts"
  },
  "dependencies": {
    "@robot-puzzle/match": "workspace:*",
    "@robot-puzzle/puzzles": "workspace:*",
    "@robot-puzzle/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.10.0",
    "@types/node": "^22.0.0",
    "esbuild": "0.25.4",
    "miniflare": "4.20251011.1",
    "vitest": "^3.2.0",
    "wrangler": "4.45.0"
  }
}
