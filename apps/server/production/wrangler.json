{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "robot-puzzle",
  "main": "../src/index.ts",
  "compatibility_date": "2025-10-11",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "vars": {
    "APP_ENV": "production",
    "ALLOWED_ORIGINS": "https://robot-puzzle.tonyivanov88.workers.dev"
  },
  "assets": {
    "directory": "../../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Registry", "Room"] }
  ]
}
