{
  "name": "@robot-puzzle/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "build": "tsc --noEmit && tsc --noEmit -p pwa/tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p pwa/tsconfig.json"
  },
  "dependencies": {
    "@robot-puzzle/game-engine": "workspace:*",
    "@robot-puzzle/match": "workspace:*",
    "@robot-puzzle/puzzles": "workspace:*",
    "@robot-puzzle/shared": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
